# Copy to .env for `docker compose`. Local development values only.
POSTGRES_PASSWORD=popspot_local
# Supabase Auth (public values). See apps/api/.env.example.
AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
AUTH_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWT_SECRET=
# Local E2E only: same value as apps/web/.env.local DEV_AUTH_JWT_SECRET.
DEV_AUTH_ISSUER=popspot-dev
DEV_AUTH_JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
