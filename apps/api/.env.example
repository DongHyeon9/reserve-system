# Copy to apps/api/.env for `npm run api:dev`. Local Docker PostgreSQL defaults only.
DB_URL=jdbc:postgresql://localhost:5432/popspot
DB_USERNAME=popspot
DB_PASSWORD=popspot_local
# TEMP dev auth: must equal DEV_AUTH_JWT_SECRET in apps/web/.env.local. Replace with Supabase values (see todo/).
AUTH_ISSUER=popspot-dev
AUTH_JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
# AUTH_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
