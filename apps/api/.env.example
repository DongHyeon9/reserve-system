# Copy to apps/api/.env for `npm run api:dev`. Local Docker PostgreSQL defaults only.
DB_URL=jdbc:postgresql://localhost:5432/popspot
DB_USERNAME=popspot
DB_PASSWORD=popspot_local
# Supabase Auth (public values). Use AUTH_JWT_SECRET instead of AUTH_JWKS_URI only for legacy HS256 projects.
AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
AUTH_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Local E2E only: must equal apps/web DEV_AUTH_JWT_SECRET. Refused under the prod profile.
DEV_AUTH_ISSUER=popspot-dev
DEV_AUTH_JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
# Required with the dev seed (V1000) so newer schema versions still apply.
FLYWAY_OUT_OF_ORDER=true
