API_BASE_URL=http://localhost:8080
# Supabase Auth (browser-safe values only; never put a service-role key here)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>
# Fallback origin for sign-up confirmation links when the request host is unknown
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local E2E dev login only (Playwright turns it on). Never enable in production.
DEV_AUTH_ENABLED=false
DEV_AUTH_ISSUER=popspot-dev
DEV_AUTH_JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
