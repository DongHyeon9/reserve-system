API_BASE_URL=http://localhost:8080
# Supabase Auth (browser-safe values only; never put a service-role key here)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>
# Origin for email-confirmation and OAuth return links. Required in production (request Host headers are never used).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local E2E dev login only (Playwright turns it on). Never enable in production.
DEV_AUTH_ENABLED=false
DEV_AUTH_ISSUER=popspot-dev
DEV_AUTH_JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
# Social sign-in buttons, enabled after the provider is set up in Supabase (todo/04-social-login.md). e.g. google,kakao
AUTH_PROVIDERS=
# true when the Kakao app cannot receive email (no business app): request profile scopes only.
AUTH_KAKAO_WITHOUT_EMAIL=false
